<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements of the bundled Node.js runtime (sidecar/node/bin/node): V8 generates
  machine code at run time. Library validation stays on: the native addons it loads (better-sqlite3,
  Temporal core bridge) are signed with the same Developer ID by scripts/build-macos.sh.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
