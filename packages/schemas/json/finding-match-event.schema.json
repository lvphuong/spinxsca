{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string"
    },
    "scanId": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "findingId": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "EXACT_FINGERPRINT",
        "RELOCATED",
        "NEAR",
        "NONE"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "NEW",
        "EXISTING",
        "REOPENED",
        "RESOLVED",
        "NOT_REEVALUATED",
        "NEEDS_RECONCILIATION"
      ]
    },
    "decidedBy": {
      "type": "string",
      "enum": [
        "host",
        "reviewer",
        "human"
      ]
    },
    "detail": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "eventId",
    "scanId",
    "findingId",
    "method",
    "confidence",
    "decision",
    "decidedBy",
    "detail",
    "createdAt"
  ]
}
