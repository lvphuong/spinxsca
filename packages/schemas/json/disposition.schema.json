{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dispositionId": {
      "type": "string"
    },
    "findingId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "FALSE_POSITIVE",
        "ACCEPTED_RISK",
        "WONT_FIX",
        "DUPLICATE_OF"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "duplicateOf": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PROJECT",
            "BRANCH",
            "SNAPSHOT"
          ]
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "ref"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "decidedBy": {
      "type": "string"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "dispositionId",
    "findingId",
    "kind",
    "reason",
    "scope",
    "decidedBy",
    "decidedAt"
  ]
}
