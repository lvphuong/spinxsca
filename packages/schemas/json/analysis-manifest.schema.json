{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "scanId": {
      "type": "string"
    },
    "engineVersion": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "contentManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commitSha": {
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "contentManifestDigest"
      ]
    },
    "scannerBundle": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "adapterVersion": {
                "type": "string"
              },
              "toolVersion": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "adapterVersion",
              "toolVersion",
              "image"
            ]
          }
        }
      },
      "required": [
        "digest",
        "scanners"
      ]
    },
    "ruleBundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "ruleCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "version",
          "digest",
          "ruleCount"
        ]
      }
    },
    "knowledgeBase": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "snapshotId": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "snapshotId",
            "digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "aiPolicy": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "off",
            "explain",
            "standard",
            "deep"
          ]
        },
        "policyVersion": {
          "type": "string"
        },
        "promptBundleDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "policyVersion"
      ]
    },
    "scanMode": {
      "type": "string",
      "enum": [
        "FULL",
        "INCREMENTAL",
        "QUICK",
        "TARGETED",
        "DEPENDENCY_REASSESSMENT",
        "RULE_REASSESSMENT",
        "FINDING_VERIFICATION",
        "AI_REANALYSIS"
      ]
    },
    "baselineScanId": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "exclude"
      ]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "scanId",
    "engineVersion",
    "source",
    "scannerBundle",
    "ruleBundles",
    "knowledgeBase",
    "aiPolicy",
    "scanMode",
    "scope",
    "requestedAt"
  ]
}
