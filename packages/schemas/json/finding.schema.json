{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "string",
      "enum": [
        "SQL_INJECTION",
        "NOSQL_INJECTION",
        "COMMAND_INJECTION",
        "CODE_INJECTION",
        "XSS",
        "PATH_TRAVERSAL",
        "SSRF",
        "OPEN_REDIRECT",
        "XXE",
        "INSECURE_DESERIALIZATION",
        "MISSING_AUTHENTICATION",
        "MISSING_AUTHORIZATION",
        "BROKEN_OBJECT_LEVEL_AUTHORIZATION",
        "TENANT_ISOLATION",
        "HARDCODED_SECRET",
        "WEAK_CRYPTO",
        "INSECURE_RANDOMNESS",
        "CSRF",
        "INSECURE_CONFIGURATION",
        "VULNERABLE_DEPENDENCY",
        "RACE_CONDITION",
        "BUSINESS_LOGIC",
        "PROTOTYPE_POLLUTION",
        "LOG_INJECTION",
        "SENSITIVE_DATA_EXPOSURE",
        "OTHER"
      ]
    },
    "ruleFamily": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "cwe": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CWE-\\d+$"
      }
    },
    "canonicalFingerprint": {
      "type": "string"
    },
    "fingerprintAlgorithm": {
      "type": "string"
    },
    "firstSeenScanId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "findingId",
    "projectId",
    "seq",
    "category",
    "ruleFamily",
    "title",
    "cwe",
    "canonicalFingerprint",
    "fingerprintAlgorithm",
    "firstSeenScanId",
    "createdAt"
  ]
}
