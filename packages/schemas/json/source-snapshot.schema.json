{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshotId": {
      "type": "string"
    },
    "repositoryId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "GIT_COMMIT",
        "WORKSPACE"
      ]
    },
    "commitSha": {
      "type": "string"
    },
    "treeSha": {
      "type": "string"
    },
    "branchAtCapture": {
      "type": "string"
    },
    "contentManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fileListDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "snapshotId",
    "repositoryId",
    "kind",
    "contentManifestDigest",
    "fileCount",
    "fileListDigest",
    "capturedAt"
  ]
}
