{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assessmentId": {
      "type": "string"
    },
    "findingId": {
      "type": "string"
    },
    "scanId": {
      "type": "string"
    },
    "occurrenceId": {
      "type": "string"
    },
    "reconciliationState": {
      "type": "string",
      "enum": [
        "NEW",
        "EXISTING",
        "REOPENED",
        "RESOLVED",
        "NOT_REEVALUATED",
        "NEEDS_RECONCILIATION"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "POTENTIAL",
        "UNLIKELY",
        "NOT_EVALUATED"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "severityBaseline": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "exploitability": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "POTENTIAL",
        "UNLIKELY",
        "UNKNOWN"
      ]
    },
    "verificationLevel": {
      "type": "string",
      "enum": [
        "L1_STATIC",
        "L2_CONTEXT",
        "L3_CONTROLLED"
      ]
    },
    "attackPath": {
      "type": "object",
      "properties": {
        "attacker": {
          "type": "string"
        },
        "entryPoint": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sink": {
          "type": "string"
        },
        "preconditions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controls": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasoningSummary": {
      "type": "string"
    },
    "changeCauses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CODE_CHANGE",
          "DEPENDENCY_CHANGE",
          "NEW_ADVISORY",
          "ADVISORY_UPDATED",
          "RULE_ADDED",
          "RULE_UPDATED",
          "SCANNER_UPGRADED",
          "AI_REASSESSMENT",
          "COVERAGE_CHANGE",
          "FIRST_SCAN",
          "UNKNOWN"
        ]
      }
    },
    "intel": {
      "type": "object",
      "properties": {
        "cves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kev": {
          "type": "object",
          "properties": {
            "dateAdded": {
              "type": "string"
            },
            "dueDate": {
              "type": "string"
            },
            "ransomware": {
              "type": "boolean"
            },
            "catalogVersion": {
              "type": "string"
            }
          },
          "required": [
            "dateAdded",
            "ransomware",
            "catalogVersion"
          ]
        },
        "epss": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "percentile": {
              "type": "number"
            },
            "date": {
              "type": "string"
            }
          },
          "required": [
            "score",
            "percentile",
            "date"
          ]
        },
        "cvss": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "baseScore": {
              "type": "number"
            },
            "vector": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "baseScore",
            "vector",
            "source"
          ]
        },
        "cwes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "cves"
      ]
    },
    "applicability": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "AFFECTED",
            "NOT_AFFECTED",
            "UNDER_INVESTIGATION"
          ]
        },
        "justification": {
          "type": "string",
          "enum": [
            "component_not_present",
            "vulnerable_code_not_present",
            "vulnerable_code_not_in_execute_path",
            "vulnerable_code_cannot_be_controlled_by_adversary",
            "inline_mitigations_already_exist"
          ]
        },
        "reachability": {
          "type": "string",
          "enum": [
            "CALLED_FROM_ENTRYPOINT",
            "CALLED",
            "IMPORTED_ONLY",
            "NOT_IMPORTED",
            "UNKNOWN_TRANSITIVE"
          ]
        },
        "symbolSource": {
          "type": "string",
          "enum": [
            "advisory",
            "model",
            "none"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "runtime",
            "development",
            "test",
            "unknown"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "status",
        "detail"
      ]
    },
    "poc": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "NOT_CONFIRMED",
            "INVALID_HARNESS",
            "BLOCKED",
            "ERROR"
          ]
        },
        "oracle": {
          "type": "string",
          "enum": [
            "CANARY_READ",
            "COMMAND_MARKER",
            "DATA_DIFFERENTIAL",
            "UNESCAPED_REFLECTION"
          ]
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attackTriggered": {
          "type": "boolean"
        },
        "controlTriggered": {
          "type": "boolean"
        },
        "harnessDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reviewedBy": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "outcome",
        "runs",
        "attackTriggered",
        "controlTriggered",
        "detail"
      ]
    },
    "discoveredBy": {
      "type": "string",
      "enum": [
        "scanner",
        "ai"
      ]
    },
    "assessedBy": {
      "type": "string"
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "assessmentId",
    "findingId",
    "scanId",
    "reconciliationState",
    "classification",
    "severity",
    "confidence",
    "exploitability",
    "verificationLevel",
    "evidenceIds",
    "counterevidence",
    "missingEvidence",
    "reasoningSummary",
    "changeCauses",
    "assessedBy",
    "assessedAt"
  ]
}
